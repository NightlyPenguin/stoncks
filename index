<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Training Log — Optimized</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#15171A; --surface:#1C1F22; --surface-2:#23262A; --border:#31353A;
    --border-soft:#2A2D31; --text:#ECEDEE; --text-muted:#9AA0A6; --text-faint:#5E6469;
    --accent:#F2C14E; --accent-soft:#3A331E; --success:#7CB88F; --success-soft:#1E2A22;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--text);font-family:'Inter',sans-serif;-webkit-font-smoothing:antialiased;}
  #app{max-width:980px;margin:0 auto;padding:0 16px 60px;}
  header{padding:20px 0 10px;border-bottom:1px solid var(--border)}
  h1{font-family:'Oswald',sans-serif;font-size:26px;margin:0 0 10px}
  .control-row{display:flex;gap:12px;align-items:center;flex-wrap:wrap}
  .field{display:flex;align-items:center;gap:8px}
  .field label{font-size:12px;color:var(--text-muted)}
  input[type=date],input[type=number],select{background:var(--surface-2);border:1px solid var(--border);color:var(--text);padding:6px 10px;border-radius:4px;font-size:13px}
  input[type=number]{width:64px}
  button.ghost{background:transparent;border:1px solid var(--border);color:var(--text-muted);padding:6px 12px;border-radius:4px;cursor:pointer}
  button.ghost:hover{color:var(--text)}
  .progress-badge{margin-left:auto;font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--text-muted);border:1px solid var(--border-soft);padding:6px 10px;border-radius:4px}
  .block-tag{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--accent);background:var(--accent-soft);padding:5px 10px;border-radius:4px}
  nav#dayTabs{display:flex;overflow-x:auto;border-bottom:1px solid var(--border);background:var(--surface);padding:6px 0}
  .tab{flex:0 0 auto;padding:10px 14px;cursor:pointer;border-bottom:3px solid transparent;font-family:'Oswald',sans-serif;font-size:14px;color:var(--text-muted);white-space:nowrap}
  .tab.active{color:var(--text);border-color:var(--accent)}
  main#dayContent{padding:18px 0}
  .exercise{background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);border:1px solid var(--border-soft);padding:12px;border-radius:8px;margin-bottom:12px}
  .exercise .title{display:flex;gap:8px;align-items:center;margin-bottom:10px}
  .exercise .title h3{margin:0;font-family:'Oswald',sans-serif;font-size:14px}
  .set-list{display:grid;grid-template-columns:40px 1fr 80px 80px;gap:8px;align-items:center}
  .set-row{display:contents}
  .set-row input{background:transparent;border:1px solid var(--border);padding:6px;border-radius:4px;color:var(--text);font-family:'JetBrains Mono',monospace}
  .set-row .reps{width:64px}
  .set-row .weight{width:70px}
  .set-controls{display:flex;gap:6px}
  .history-controls{display:flex;gap:12px;align-items:center;margin:12px 0}
  .history-panel{border-top:1px solid var(--border);padding-top:12px}
  .history-empty{color:var(--text-faint);padding:20px 0;text-align:center}
  table.history-table{width:100%;border-collapse:collapse;font-family:'JetBrains Mono',monospace;font-size:12px}
  table.history-table th, table.history-table td{border-bottom:1px solid var(--border-soft);padding:8px;text-align:left;white-space:nowrap}
  table.history-table th{color:var(--text-faint);font-size:11px}
  @media(max-width:640px){ .set-list{grid-template-columns:30px 1fr 70px 60px} }
</style>
</head>
<body>
<div id="app">
  <header>
    <h1>Training Log</h1>
    <div class="control-row">
      <div class="field">
        <label for="weekInput">Week</label>
        <input id="weekInput" type="number" min="1" max="12" value="1" />
      </div>
      <span class="block-tag" id="blockTag">Block A · Weeks 1-5</span>
      <div class="field">
        <label for="dateInput">Session date</label>
        <input id="dateInput" type="date" />
      </div>
      <button class="ghost" id="todayBtn">Today</button>
      <button class="ghost" id="historyToggleBtn">History</button>
      <span class="progress-badge" id="progressBadge">0 / 0 logged</span>
    </div>
  </header>

  <nav id="dayTabs" aria-label="Days"></nav>

  <main id="dayContent" role="main"></main>

  <section id="historyView" style="display:none">
    <div class="history-controls">
      <div class="field"><label for="histBlockSelect">Block</label><select id="histBlockSelect"></select></div>
      <div class="field"><label for="histDaySelect">Day</label><select id="histDaySelect"></select></div>
      <button class="ghost" id="histLoadBtn">Load</button>
    </div>
    <div class="history-panel" id="historyPanel"></div>
  </section>
</div>

<script>
/*
  Training Log — Optimized single-file
  Key optimizations:
   - Robust async storage wrapper with localStorage fallback
   - Debounced autosave
   - Normalize session data shape
   - Parallel session loading for history
   - Batched DOM updates with DocumentFragment
   - Event delegation for input handling
*/

(function(){
  // -------------------------
  // Data: Blocks & Days (kept compact for readability)
  // Replace or extend this BLOCKS array with your full original content if you want exact parity.
  // -------------------------
  const BLOCKS = [
    { id: 'A', label: 'Block A · Weeks 1-5', weeks: [1,5],
      days: [
        { id: 'upper', name: 'Upper', rest: false, exercises: [
          { name: 'Bench Press', sets: 5, reps: '5', warmup: 2, rpe: 8 },
          { name: 'Overhead Press', sets: 4, reps: '6', warmup: 2, rpe: 8 },
        ]},
        { id: 'lower', name: 'Lower', rest: false, exercises: [
          { name: 'Squat', sets: 5, reps: '5', warmup: 2, rpe: 8 },
          { name: 'Romanian Deadlift', sets: 3, reps: '8', warmup: 1 },
        ]},
        { id: 'restA', name: 'Rest', rest: true, exercises: []}
      ]
    },
    { id: 'B', label: 'Block B · Weeks 6-12', weeks: [6,12],
      days: [
        { id: 'pull', name: 'Pull', rest: false, exercises: [
          { name: 'Barbell Row', sets: 4, reps: '6' },
          { name: 'Chin-Up', sets: 4, reps: '6' }
        ]},
        { id: 'push', name: 'Push', rest: false, exercises: [
          { name: 'Incline Bench', sets: 4, reps: '6' },
          { name: 'Dips', sets: 3, reps: '8' }
        ]},
        { id: 'legs', name: 'Legs', rest: false, exercises: [
          { name: 'Front Squat', sets: 4, reps: '6' },
          { name: 'Leg Curl', sets: 3, reps: '10' }
        ]}
      ]
    }
  ];

  // -------------------------
  // Utilities: date, format, helpers
  // -------------------------
  const $ = (sel, root=document) => root.querySelector(sel);
  const $$$ = (sel, root=document) => Array.from(root.querySelectorAll(sel));
  const fmtDate = d => {
    if(!d) return '';
    const dt = (d instanceof Date) ? d : new Date(d);
    if (isNaN(dt)) return '';
    return dt.toISOString().slice(0,10);
  };
  const todayISO = ()=> fmtDate(new Date());
  const safeParse = s => { try { return JSON.parse(s); } catch(e){ return null } };

  // -------------------------
  // Robust async storage wrapper
  // - tries window.storage.get/set if present (handles shape {value:...})
  // - falls back to localStorage (wrapped async)
  // - if neither available, becomes no-op but warns user
  // -------------------------
  const StorageBackend = (() => {
    const hasWindowStorage = typeof window !== 'undefined' && window.storage && typeof window.storage.get === 'function';
    const hasLocal = typeof window !== 'undefined' && window.localStorage;
    const warnNoop = () => { console.warn('No persistent storage available — using in-memory fallback for this session'); };
    let inMemory = {};

    async function get(key){
      if(hasWindowStorage){
        try{
          const res = await window.storage.get(key);
          // window.storage.get may return { value: X } or X directly
          if(res && typeof res === 'object' && res.hasOwnProperty('value')) return res.value;
          return res;
        }catch(e){
          console.warn('window.storage.get failed, falling back', e);
        }
      }
      if(hasLocal){
        try{
          const raw = localStorage.getItem(key);
          return raw === null ? undefined : safeParse(raw);
        }catch(e){
          console.warn('localStorage.get failed, falling back to memory', e);
        }
      }
      // fallback to in-memory
      return inMemory.hasOwnProperty(key) ? inMemory[key] : undefined;
    }

    async function set(key, value){
      if(hasWindowStorage){
        try{
          // some implementations expect {key: value} or (key, value) — try the common one
          if(typeof window.storage.set === 'function'){
            await window.storage.set({ [key]: value });
            return true;
          }
        }catch(e){
          console.warn('window.storage.set failed, trying localStorage', e);
        }
      }
      if(hasLocal){
        try{
          localStorage.setItem(key, JSON.stringify(value));
          return true;
        }catch(e){
          console.warn('localStorage.set failed, using in-memory', e);
        }
      }
      inMemory[key] = value;
      warnNoop();
      return true;
    }

    async function remove(key){
      if(hasWindowStorage){
        try{ await window.storage.remove(key); return true; } catch(e){ /*ignore*/ }
      }
      if(hasLocal){
        try{ localStorage.removeItem(key); return true; } catch(e){ /*ignore*/ }
      }
      delete inMemory[key];
      return true;
    }

    return { get, set, remove, _hasWindowStorage: hasWindowStorage, _hasLocalStorage: hasLocal };
  })();

  // -------------------------
  // App state
  // -------------------------
  let currentWeek = 1;
  let currentBlock = BLOCKS[0];
  let currentDay = currentBlock.days[0];
  let currentDate = todayISO();
  const weekInputEl = $('#weekInput');
  const dateInputEl = $('#dateInput');
  const blockTagEl = $('#blockTag');
  const dayTabsEl = $('#dayTabs');
  const dayContentEl = $('#dayContent');
  const todayBtn = $('#todayBtn');
  const historyToggleBtn = $('#historyToggleBtn');
  const progressBadge = $('#progressBadge');
  const historyView = $('#historyView');
  const histBlockSelect = $('#histBlockSelect');
  const histDaySelect = $('#histDaySelect');
  const histLoadBtn = $('#histLoadBtn');
  const historyPanel = $('#historyPanel');

  // -------------------------
  // Keys & data helpers
  // -------------------------
  const keyWeek = () => 'meta:week';
  const keyDates = (blockId, dayId) => `dates:${blockId}:${dayId}`; // stores array of dates (strings)
  const keySession = (blockId, dayId, date) => `session:${blockId}:${dayId}:${date}`; // stores session object

  // Normalize session shape: ensure exercises object exists etc.
  function normalizeSession(raw, blockId, dayId, date){
    const session = (raw && typeof raw === 'object') ? JSON.parse(JSON.stringify(raw)) : {};
    session.date = fmtDate(date || session.date || date || currentDate);
    session.blockId = blockId || session.blockId || (currentBlock && currentBlock.id);
    session.dayId = dayId || session.dayId || (currentDay && currentDay.id);
    session.exercises = session.exercises || {};
    // Initialize entries for each exercise index to have consistent shape
    const dayDef = (BLOCKS.find(b=>b.id === session.blockId) || BLOCKS[0]).days.find(d=>d.id === session.dayId) || currentDay;
    (dayDef.exercises || []).forEach((ex, idx) => {
      if(!session.exercises[idx]) session.exercises[idx] = { variant: '', extra: '', sets: Array.from({length: ex.sets || 0}, ()=>({weight:'',reps:''})) };
      else {
        // ensure sets array has right length
        session.exercises[idx].sets = session.exercises[idx].sets || [];
        while(session.exercises[idx].sets.length < (ex.sets||0)) session.exercises[idx].sets.push({weight:'', reps:''});
      }
    });
    return session;
  }

  // -------------------------
  // Debounce helper
  // -------------------------
  function debounce(fn, wait){
    let t;
    return function(...args){
      clearTimeout(t);
      t = setTimeout(()=>fn.apply(this,args), wait);
    };
  }

  const saveSessionDebounced = debounce(saveSessionImmediate, 400);

  // -------------------------
  // Core persistence functions
  // -------------------------
  async function saveWeekPref(week){
    try{ await StorageBackend.set(keyWeek(), Number(week)); } catch(e){ console.warn(e); }
  }
  async function loadWeekPref(){
    try{ const v = await StorageBackend.get(keyWeek()); return Number(v) || undefined } catch(e){ return undefined; }
  }

  async function saveSessionImmediate(session){
    // Session must be normalized before calling (or call normalize here)
    try{
      if(!session || !session.date) return;
      const key = keySession(session.blockId, session.dayId, session.date);
      await StorageBackend.set(key, session);
      // ensure date is in dates list
      const datesKey = keyDates(session.blockId, session.dayId);
      const existing = (await StorageBackend.get(datesKey)) || [];
      const s = new Set(existing);
      if(!s.has(session.date)){
        existing.push(session.date);
        existing.sort(); // ISO strings sort ascending
        await StorageBackend.set(datesKey, existing);
      }
      // UI feedback
      updateProgressBadge(session);
    }catch(e){
      console.error('Failed to save session', e);
    }
  }

  async function saveSessionFromState(){
    // gather state from DOM to create session object and save (used on explicit save)
    const session = buildSessionFromDom();
    await saveSessionImmediate(session);
  }

  async function loadSession(blockId, dayId, date){
    const key = keySession(blockId, dayId, date);
    const raw = await StorageBackend.get(key);
    return normalizeSession(raw, blockId, dayId, date);
  }

  async function loadDatesFor(blockId, dayId){
    const raw = await StorageBackend.get(keyDates(blockId, dayId));
    return Array.isArray(raw) ? raw.slice() : [];
  }

  // Find previous session date (strictly before targetDate). Dates array assumed sorted ascending.
  function findPrevSessionDate(dates, targetDate){
    if(!Array.isArray(dates) || dates.length===0) return null;
    const t = fmtDate(targetDate);
    let lo=0, hi=dates.length-1, ans = null;
    while(lo<=hi){
      const mid = Math.floor((lo+hi)/2);
      if(dates[mid] < t){ ans = dates[mid]; lo = mid+1; }
      else hi = mid-1;
    }
    return ans;
  }

  // -------------------------
  // DOM rendering helpers — batched where possible
  // -------------------------
  function renderTabs(){
    dayTabsEl.innerHTML = '';
    const frag = document.createDocumentFragment();
    const days = currentBlock.days || [];
    days.forEach(d => {
      const btn = document.createElement('button');
      btn.className = 'tab' + (d.id === currentDay.id ? ' active' : '');
      btn.dataset.dayId = d.id;
      btn.type = 'button';
      btn.textContent = d.name + (d.rest ? ' (Rest)' : '');
      frag.appendChild(btn);
    });
    dayTabsEl.appendChild(frag);
  }

  function renderDayContent(session){
    dayContentEl.innerHTML = ''; // keep single replacement; inside we will build full structure once
    const frag = document.createDocumentFragment();
    const dayDef = currentDay;
    (dayDef.exercises || []).forEach((ex, exIndex) => {
      const card = document.createElement('section');
      card.className = 'exercise';
      const title = document.createElement('div');
      title.className = 'title';
      const h3 = document.createElement('h3');
      h3.textContent = ex.name;
      const meta = document.createElement('div');
      meta.style.marginLeft = 'auto';
      meta.style.fontFamily = 'JetBrains Mono, monospace';
      meta.style.fontSize = '12px';
      meta.style.color = 'var(--text-faint)';
      meta.textContent = `${ex.sets || 0} × ${ex.reps || '—'}`;
      title.appendChild(h3);
      title.appendChild(meta);
      card.appendChild(title);

      const list = document.createElement('div');
      list.className = 'set-list';
      // header labels
      const labels = ['#','Notes','Weight','Reps'];
      labels.forEach(lbl => {
        const el = document.createElement('div');
        el.style.fontSize = '12px';
        el.style.color = 'var(--text-faint)';
        el.style.paddingBottom = '6px';
        el.textContent = lbl;
        list.appendChild(el);
      });

      const sessEx = (session.exercises && session.exercises[exIndex]) || { sets: [] };
      const setsCount = ex.sets || 0;
      for(let si=0; si<setsCount; si++){
        const idxCol = document.createElement('div'); idxCol.textContent = (si+1).toString();
        const noteCol = document.createElement('div');
        const noteInput = document.createElement('input'); noteInput.type='text'; noteInput.placeholder='note'; noteInput.className='note';
        noteInput.dataset.ex = exIndex; noteInput.dataset.set = si;
        noteInput.value = (sessEx.sets && sessEx.sets[si] && sessEx.sets[si].note) ? sessEx.sets[si].note : '';
        noteCol.appendChild(noteInput);

        const weightCol = document.createElement('div');
        const weightInput = document.createElement('input'); weightInput.type='number'; weightInput.className='weight';
        weightInput.dataset.ex = exIndex; weightInput.dataset.set = si; weightInput.step='0.5';
        weightInput.value = (sessEx.sets && sessEx.sets[si] && sessEx.sets[si].weight) ? sessEx.sets[si].weight : '';
        weightCol.appendChild(weightInput);

        const repsCol = document.createElement('div');
        const repsInput = document.createElement('input'); repsInput.type='number'; repsInput.className='reps';
        repsInput.dataset.ex = exIndex; repsInput.dataset.set = si;
        repsInput.value = (sessEx.sets && sessEx.sets[si] && sessEx.sets[si].reps) ? sessEx.sets[si].reps : '';
        repsCol.appendChild(repsInput);

        list.appendChild(idxCol);
        list.appendChild(noteCol);
        list.appendChild(weightCol);
        list.appendChild(repsCol);
      }

      card.appendChild(list);
      frag.appendChild(card);
    });
    dayContentEl.appendChild(frag);
    updateProgressBadge(session);
  }

  function updateProgressBadge(session){
    // Count logged sets where weight or reps are non-empty
    try{
      const dayDef = currentDay;
      let total=0, logged=0;
      (dayDef.exercises || []).forEach((ex, exIndex) => {
        const sets = (session && session.exercises && session.exercises[exIndex] && session.exercises[exIndex].sets) || [];
        total += ex.sets || 0;
        sets.forEach(s => { if(s && ((s.weight !== '' && s.weight != null) || (s.reps !== '' && s.reps != null))) logged++; });
      });
      progressBadge.textContent = `${logged} / ${total} logged`;
      if(logged === total && total>0) progressBadge.classList.add('full'); else progressBadge.classList.remove('full');
    }catch(e){ console.warn(e) }
  }

  // -------------------------
  // Build session object from DOM
  // -------------------------
  function buildSessionFromDom(){
    const date = dateInputEl.value || currentDate;
    const session = { date: fmtDate(date), blockId: currentBlock.id, dayId: currentDay.id, exercises: {} };
    const exerciseCards = $$$('.exercise', dayContentEl);
    exerciseCards.forEach((card, exIndex) => {
      session.exercises[exIndex] = session.exercises[exIndex] || { variant: '', extra: '', sets: [] };
      const setInputs = Array.from(card.querySelectorAll('.set-list .weight, .set-list .reps, .set-list .note'));
      // we created inputs in order: note, weight, reps for each set (but set-list has header + repeated columns)
      // Safer: query by data attributes
      const weights = $$$('.weight', card);
      const reps = $$$('.reps', card);
      const notes = $$$('.note', card);
      const setsCount = Math.max(weights.length, reps.length, notes.length);
      session.exercises[exIndex].sets = [];
      for(let i=0;i<setsCount;i++){
        const w = weights[i] ? weights[i].value : '';
        const r = reps[i] ? reps[i].value : '';
        const n = notes[i] ? notes[i].value : '';
        session.exercises[exIndex].sets.push({ weight: w === '' ? '' : w, reps: r === '' ? '' : r, note: n || '' });
      }
    });
    return session;
  }

  // -------------------------
  // Load / Render current session
  // -------------------------
  async function loadAndRenderSession(blockId, dayId, date){
    const session = await loadSession(blockId, dayId, date);
    // ensure session has proper sets
    const normalized = normalizeSession(session, blockId, dayId, date);
    renderDayContent(normalized);
    // attach quick save on inputs via event delegation below
  }

  // -------------------------
  // History rendering (parallel loads, batched DOM updates)
  // -------------------------
  async function renderHistory(blockId, dayId){
    historyPanel.innerHTML = '';
    const dates = await loadDatesFor(blockId, dayId);
    if(!dates || dates.length === 0){
      historyPanel.innerHTML = '<div class="history-empty">No history for this day yet.</div>';
      return;
    }
    // load all sessions in parallel
    const loads = dates.map(d => loadSession(blockId, dayId, d).catch(()=>null));
    const sessions = (await Promise.all(loads)).filter(Boolean);
    if(sessions.length === 0){
      historyPanel.innerHTML = '<div class="history-empty">No readable history entries.</div>';
      return;
    }
    // Build table showing date and first-set weight for each exercise (simple compact view)
    const frag = document.createDocumentFragment();
    const table = document.createElement('table'); table.className = 'history-table';
    const thead = document.createElement('thead');
    const trh = document.createElement('tr');
    trh.appendChild(Object.assign(document.createElement('th'), {textContent: 'Date'}));
    // assume dayDef to name columns
    const dayDef = (BLOCKS.find(b=>b.id===blockId)||BLOCKS[0]).days.find(d=>d.id===dayId) || { exercises: [] };
    dayDef.exercises.forEach(ex => { const th = document.createElement('th'); th.textContent = ex.name; trh.appendChild(th); });
    thead.appendChild(trh); table.appendChild(thead);

    const tbody = document.createElement('tbody');
    sessions.forEach(s => {
      const tr = document.createElement('tr');
      const tdDate = document.createElement('td'); tdDate.textContent = fmtDate(s.date); tr.appendChild(tdDate);
      dayDef.exercises.forEach((ex, idx) => {
        const td = document.createElement('td');
        const exData = s.exercises && s.exercises[idx];
        const firstSet = exData && exData.sets && exData.sets[0];
        td.textContent = (firstSet && (firstSet.weight || firstSet.reps)) ? `${firstSet.weight||'—'} × ${firstSet.reps||'—'}` : '—';
        tr.appendChild(td);
      });
      tbody.appendChild(tr);
    });
    table.appendChild(tbody);
    frag.appendChild(table);
    historyPanel.appendChild(frag);
  }

  // -------------------------
  // Event handling (delegated)
  // -------------------------
  // Debounced handler that reads DOM and saves session
  async function onInputChangeDebounced(){
    const session = buildSessionFromDom();
    await saveSessionDebounced(session);
  }

  function initEventHandlers(){
    // Week input
    weekInputEl.addEventListener('change', async (e) => {
      const wk = Number(e.target.value) || 1;
      currentWeek = Math.max(1, Math.min(12, wk));
      await saveWeekPref(currentWeek);
      // switch block if needed
      const newBlock = BLOCKS.find(b => (b.weeks && b.weeks[0] <= currentWeek && b.weeks[1] >= currentWeek)) || BLOCKS[0];
      if(newBlock.id !== currentBlock.id){
        currentBlock = newBlock;
        currentDay = currentBlock.days.find(d=>!d.rest) || currentBlock.days[0];
        blockTagEl.textContent = currentBlock.label;
        renderTabs();
        await loadAndRenderSession(currentBlock.id, currentDay.id, currentDate);
      }
      blockTagEl.textContent = currentBlock.label;
    });

    // date input
    dateInputEl.addEventListener('change', async (e) => {
      currentDate = fmtDate(e.target.value);
      await loadAndRenderSession(currentBlock.id, currentDay.id, currentDate);
    });

    todayBtn.addEventListener('click', async ()=>{
      currentDate = todayISO();
      dateInputEl.value = currentDate;
      await loadAndRenderSession(currentBlock.id, currentDay.id, currentDate);
    });

    // tabs click (delegation)
    dayTabsEl.addEventListener('click', async (ev) => {
      const btn = ev.target.closest('.tab');
      if(!btn) return;
      const dayId = btn.dataset.dayId;
      const dayDef = currentBlock.days.find(d=>d.id===dayId);
      if(!dayDef) return;
      currentDay = dayDef;
      // refresh active style
      $$$('.tab', dayTabsEl).forEach(t => t.classList.toggle('active', t.dataset.dayId === dayId));
      await loadAndRenderSession(currentBlock.id, currentDay.id, currentDate);
    });

    // delegated change for inputs in dayContent (weights, reps, notes)
    dayContentEl.addEventListener('input', (ev) => {
      const target = ev.target;
      // identify inputs that carry dataset.ex and dataset.set
      if(target && target.dataset && target.dataset.ex !== undefined){
        // deferred save
        onInputChangeDebounced();
      }
    });

    // history toggle
    historyToggleBtn.addEventListener('click', ()=>{
      historyView.style.display = historyView.style.display === 'none' ? 'block' : 'none';
      if(historyView.style.display === 'block'){
        // populate selects and load
        histBlockSelect.innerHTML = '';
        BLOCKS.forEach(b => {
          const opt = document.createElement('option'); opt.value = b.id; opt.textContent = b.label; histBlockSelect.appendChild(opt);
        });
        histBlockSelect.value = currentBlock.id;
        populateHistDayOptions(currentBlock.id);
        histDaySelect.value = currentDay.id;
        renderHistory(currentBlock.id, currentDay.id);
      }
    });

    histBlockSelect.addEventListener('change', (e) => {
      populateHistDayOptions(e.target.value);
    });
    histLoadBtn.addEventListener('click', ()=>{
      renderHistory(histBlockSelect.value, histDaySelect.value);
    });
  }

  function populateHistDayOptions(blockId){
    histDaySelect.innerHTML = '';
    const block = BLOCKS.find(b=>b.id===blockId) || BLOCKS[0];
    block.days.forEach(d => {
      const opt = document.createElement('option'); opt.value = d.id; opt.textContent = d.name; histDaySelect.appendChild(opt);
    });
  }

  // -------------------------
  // Initialization
  // -------------------------
  async function init(){
    // load week pref
    const wk = await loadWeekPref();
    if(wk && Number.isFinite(wk) && wk>=1 && wk<=12) currentWeek = wk;
    weekInputEl.value = currentWeek;
    // determine block from week
    currentBlock = BLOCKS.find(b=> (b.weeks && b.weeks[0] <= currentWeek && b.weeks[1] >= currentWeek)) || BLOCKS[0];
    blockTagEl.textContent = currentBlock.label;
    // set date
    currentDate = todayISO();
    dateInputEl.value = currentDate;
    // render tabs and first load
    renderTabs();
    await loadAndRenderSession(currentBlock.id, currentDay.id, currentDate);
    initEventHandlers();

    // If StorageBackend has no persistent storage, show small banner
    if(!StorageBackend._hasWindowStorage && !StorageBackend._hasLocalStorage){
      const warn = document.createElement('div');
      warn.style.cssText = 'background:#3A2020;color:#F2A0A0;padding:10px 20px;font-size:12px;font-family:JetBrains Mono, monospace;';
      warn.textContent = 'Persistent storage unavailable — session data will not survive page reloads.';
      document.body.insertBefore(warn, document.getElementById('app'));
    }
  }

  // Run init
  init().catch(e=>{ console.error('Init error', e); });

  // Expose some functions for console debugging (optional)
  window._trainingLog = {
    StorageBackend, BLOCKS, loadSession, saveSessionImmediate, loadAndRenderSession, renderHistory
  };

})();
</script>
</body>
